# ---------------------------------------------------------------------------
# Copy this file to backend/.env and replace every placeholder.
# Never commit backend/.env.
# ---------------------------------------------------------------------------

# Django
# manage.py uses development settings by default; WSGI/ASGI use production.
# Override DJANGO_SETTINGS_MODULE in the process environment if needed, not here.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO

# MySQL (the application database)
DB_NAME=bolu_wall_engine
DB_USER=bolu_app
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONNECT_TIMEOUT=10
DB_CONN_MAX_AGE=60

# Browser origins: the existing Vite frontend during local development.
# Explicit http(s) origins only. Wildcards are rejected at startup.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=False

# Authentication (django-allauth Headless + Google OAuth)
# Create an OAuth 2.0 "Web application" client in the Google Cloud console and
# add the SPA origins (http://localhost:5173 locally) as Authorized JavaScript
# origins. Client IDs/secrets belong here only: never ship the secret to the
# browser or commit a populated .env file.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Where the browser is sent if the OAuth handshake fails and its state is lost.
# FRONTEND_AUTH_ERROR_URL=http://localhost:5173/
# django.contrib.sites id used for social apps (the default Site is id 1).
# DJANGO_SITE_ID=1
# Password signup is closed by default; Google is the self-service signup path.
# AUTH_ALLOW_PASSWORD_SIGNUP=false

# JWT settings (optional; defaults shown). Access tokens are short lived and
# refresh tokens rotate on every refresh. HS256 uses DJANGO_SECRET_KEY unless a
# private key is supplied; RS256 requires the PEM private key.
# AUTH_JWT_ALGORITHM=HS256
# AUTH_ACCESS_TOKEN_LIFETIME_SECONDS=900
# AUTH_REFRESH_TOKEN_LIFETIME_SECONDS=604800
# AUTH_JWT_STATEFUL_VALIDATION=true
# AUTH_JWT_PRIVATE_KEY=

# API pagination and abuse control (optional; defaults shown).
# API_PAGE_SIZE=24
# API_MAX_PAGE_SIZE=60
# API_DOWNLOAD_THROTTLE_RATE=60/minute

# Upload limits in bytes (optional; defaults shown).
# WALLPAPER_IMAGE_MAX_BYTES=15728640
# WALLPAPER_THUMBNAIL_MAX_BYTES=5242880
# CATEGORY_IMAGE_MAX_BYTES=5242880

# ---------------------------------------------------------------------------
# Production examples (do not use these values locally).
# Set DJANGO_SETTINGS_MODULE=config.settings.production and use a real secret.
# ---------------------------------------------------------------------------
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=api.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com
# CSRF_TRUSTED_ORIGINS=https://app.example.com
# CORS_ALLOW_CREDENTIALS=False
# DB_HOST=db.internal.example.com
# DB_PORT=3306
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_TRUST_X_FORWARDED_PROTO=True
