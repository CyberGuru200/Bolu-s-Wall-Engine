# Copy to .env.local (Git-ignored) and restart Vite.
# Leave VITE_API_BASE_URL empty to keep the bundled catalogue and browser-local
# likes/saves. Set it to run against the Django API.
VITE_API_BASE_URL=
# Example: VITE_API_BASE_URL=http://127.0.0.1:8000

# Public Google OAuth client ID (same value as backend GOOGLE_OAUTH_CLIENT_ID).
# Only public values belong in VITE_* variables. Never put the OAuth client
# secret, database credentials, or JWT keys in this file.
VITE_GOOGLE_CLIENT_ID=
