# Dependencies and build output
node_modules/
dist/
coverage/
playwright-report/
test-results/

# Secrets: real environment files are never committed. The example files,
# which contain placeholders only, are kept.
.env
.env.*
!.env.example

# Python virtual environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local Django runtime data: the database file, uploads, and collected static
media/
staticfiles/
*.sqlite3

# Machine and editor noise
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.log
